# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / generated CMS seed artifacts
.cursor/
.playwright-cli/
scripts/seed-sql/
scripts/seed-batches/
scripts/seed-json-chunks/
scripts/seed-rpc/

# generated WordPress comparison HTML dumps
docs/rendered-all-services-content/
docs/rendered-all-services-content-v2/
docs/rendered-all-services-content-v3/
docs/rendered-proposed-service-content-v2/
docs/rendered-service-comparison/
